# Goldenspice backend environment configuration
#
# Copy this file to .env for local development and replace
# the placeholder values. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5433/goldenspice_db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated frontend origins allowed to call the API.
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CORS_ORIGINS=https://goldenspice.co.ke,https://www.goldenspice.co.ke