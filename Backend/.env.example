# Goldenspice backend environment configuration
#
# Copy this file to .env for local development and replace
# the placeholder values. Never commit the real .env file.

# Application
APP_NAME=Goldenspice API
APP_ENV=development
APP_VERSION=1.0.0

# Production:
# APP_ENV=production

DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5433/goldenspice_db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated frontend origins allowed to call the API.
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CORS_ORIGINS=https://goldenspice.co.ke,https://www.goldenspice.co.ke
# Production server
#
# Most hosting platforms provide PORT automatically.
# Local fallback is 8000.
# PORT=8000
#
# Comma-separated proxy IPs/networks trusted for forwarded headers.
# Keep this restricted to the actual reverse proxy in production.
# FORWARDED_ALLOW_IPS=127.0.0.1
